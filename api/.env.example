# Copy to api/.env and fill in. Never commit api/.env.
GEMINI_API_KEY=
# Optional: override the model fallback chain
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Optional: USDA FoodData Central key for the generic food fallback (free at api.data.gov)
# USDA_API_KEY=
# Session cookie is Secure by default (works on http://localhost in modern browsers).
# Set to 1 only for plain-http dev on another host name.
TEJU_COOKIE_INSECURE=0
# Local demo account created by python -m teju.seed (dev only)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=teju-demo-2026
